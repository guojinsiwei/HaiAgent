# Documentation only: no automatic .env loading. Export these variables in the
# same shell/environment that runs tb. Never send a real key with this package.
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=replace-with-your-provider-model-id
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional launch-script settings:
RETRAC_ROUNDS=8
RETRAC_MAX_SECONDS=3600
RETRAC_HARNESS_TIMEOUT=3900
